      "FAQ": {
        "variants": {
          "CommonGroundFAQ1": {
            "id": "faq",
            "eyebrow": "QUESTIONS & CONVERSATION",
            "headingPart1": "Common ground,",
            "headingItalic": "honest answers.",
            "subtitle": "Find clear answers on our grassroots initiatives, transparent fund allocation, and how you can take part.",
            "items": [
              {
                "id": "faq-1",
                "question": "What is Common Ground?",
                "answer": "Common Ground is an illustrative NGO concept designed to showcase how grassroots community initiatives, environmental conservation, and local education can work together. In a real deployment, this would be your mission, history, and core values."
              },
              {
                "id": "faq-2",
                "question": "How are donations and funds used?",
                "answer": "Every contribution directly supports community-led programs: purchasing organic seeds, building clean rainwater catchment, providing classroom supplies, and training grassroots coordinators. We maintain open financial reporting with quarterly public impact statements."
              },
              {
                "id": "faq-3",
                "question": "Can I volunteer or get involved locally?",
                "answer": "Yes! Whether you're an educator, gardener, event organizer, or neighbor who wants to lend a hand, we welcome all backgrounds. Explore our Causes and Contact sections to connect with a field team in your area."
              },
              {
                "id": "faq-4",
                "question": "How do you choose your project locations?",
                "answer": "We respond exclusively to invitations from local communities. Before launching any initiative, our outreach team spends months listening to residents, assessing environmental needs, and establishing local leadership committees."
              },
              {
                "id": "faq-5",
                "question": "Are you a registered non-profit organization?",
                "answer": "Common Ground operates as a registered 501(c)(3) tax-exempt non-profit organization. All donations within the United States are tax-deductible to the full extent permissible by law."
              }
            ]
          }
        }
      },
